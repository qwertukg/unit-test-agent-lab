# Run scripts/init_env.py to create .env with random LOCAL service secrets.
POSTGRES_PASSWORD=
GITLAB_ROOT_PASSWORD=
API_TOKEN=
WEBHOOK_SECRET=
MODEL_API_KEY=
GATEWAY_KEY=
# Filled by bootstrap with a Developer bot token, never the root token.
GITLAB_TOKEN=
# User supplies locally. CLOUD_MODEL uses a LiteLLM provider/model identifier.
# For an OpenAI-compatible local server: CLOUD_MODEL=openai/<served-model-id>,
# CLOUD_BASE_URL=http://host:port/v1, MODEL_MODE=local, TOKEN_PRICE_UPPER_USD=0.
# CLOUD_API_KEY is the server key (or a nonsecret placeholder if it has no auth).
CLOUD_MODEL=
CLOUD_API_KEY=
CLOUD_BASE_URL=
# Conservative maximum price per 1M tokens (input/output/reasoning). Required for cloud runs.
TOKEN_PRICE_UPPER_USD=0
MAX_COST_USD=5
MAX_TOTAL_TOKENS=250000
MAX_MODEL_CALLS=32
MAX_ITERATIONS=4
MAX_RUN_SECONDS=3600
DATABASE_URL=postgresql://lab:lab@localhost:55432/lab
GITLAB_URL=http://localhost:8929
GITLAB_PUBLIC_URL=http://localhost:8929
MODEL_BASE_URL=http://localhost:4000/v1
MODEL_ALIAS=test-agent
MODEL_MODE=cloud
# Explicit compatibility mode for servers without native JSON constraints.
# Both modes still require strict schema validation and a real capability probe.
MODEL_JSON_MODE=json_object
MODEL_TIMEOUT=120
UPSTREAM_TIMEOUT_SECONDS=120
PROJECT_CONFIG=config/projects.yaml
