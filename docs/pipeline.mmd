%% Актуализированная копия для передачи; не отчёт о развёрнутом стенде.
%% Целевая инфраструктура; локальная облачная топология в lab-topology.mmd.
flowchart TD

    subgraph LEGEND["ЛЕГЕНДА"]
        direction TB
        LA["действие: операция пайплайна"]
        LG["агент: работа модели с инструментами"]
        LO[/"объекты: входные и выходные данные"/]
        LC{"условие: проверка или выбор"}
        LS["сервис / сервер: инфраструктура"]
        LD[("хранилище: постоянные данные")]
        LB(["событие: начало"])
        LE(["завершение: конец"])
        subgraph LP["Переход процесса"]
            direction LR
            LP1["действие: предыдущий шаг"]
            LP2["действие: следующий шаг"]
            LP1 --> LP2
        end
        subgraph LF["Доступ к объектам вне основного перехода"]
            direction LR
            LF1[/"объекты: Сценарии"/]
            LF2["агент: Coder"]
            LF1 -.-> LF2
        end
        subgraph LQ["Условный переход"]
            direction LR
            LQ1{"условие: проверка пройдена?"}
            LQ2["действие: продолжить"]
            LQ3["действие: исправить"]
            LQ1 -->|"Да"| LQ2
            LQ1 -->|"Нет"| LQ3
        end
        subgraph LI["Обращение к инфраструктуре"]
            direction LR
            LI1["сервис: агентная система"]
            LI2["сервис: LiteLLM Proxy"]
            LI1 -.->|"Запрос к модели"| LI2
        end
    end

    START(["событие: 1.1
    Создан или обновлён исходный MR
    feature → dev"])
    LEGEND ~~~ START

    subgraph S1["1. Проверка исходного MR — GitLab и Runner"]
        direction TB
        CI["действие: 1.2
        Runner запускает юнит-тесты;
        формирует отчёты;
        рассчитывает покрытие и результат QG"]
        VALID{"условие: 1.3
        Исходные отчёты
        и результат QG доступны?"}
        CIERR(["завершение: 1.4
        Ошибка исходного CI
        Передать диагностику человеку;
        агентный пайплайн не запускать"])
        QG{"условие: 1.5
        QG по покрытию не пройден?"}
        PASS(["завершение: 1.6
        Продолжить обычный процесс MR
        Агентный пайплайн не требуется"])
        ELIGIBLE{"условие: 1.7
        MR разрешён для обработки
        и не является собственным MR с тестами?"}
        IGNORE(["завершение: 1.8
        Не запускать агентный пайплайн
        Исключить обработку собственных MR"])
        UNIQUE{"условие: 1.9
        Такой запуск уже зарегистрирован
        или выполняется?"}
        EXISTING(["завершение: 1.10
        Использовать существующий запуск;
        не создавать дубликат"])
        CI --> VALID
        VALID -->|"Нет"| CIERR
        VALID -->|"Да"| QG
        QG -->|"Нет"| PASS
        QG -->|"Да"| ELIGIBLE
        ELIGIBLE -->|"Нет"| IGNORE
        ELIGIBLE -->|"Да"| UNIQUE
        UNIQUE -->|"Да"| EXISTING
    end

    subgraph S2["2. Подготовка контекста — агентный сервис в Kubernetes"]
        direction TB
        PREP["действие: 2.1
        Зарегистрировать запуск;
        зафиксировать проект, MR, SHA и базу diff;
        зафиксировать версию центральных инструкций"]
        COLLECT["действие: 2.2
        Получить задачу через YouTrack MCP;
        получить diff и отчёты через GitLab MCP / API;
        подготовить репозиторий на заданном SHA;
        проверить соответствие отчётов ревизии"]
        INPUT[/"объекты: 2.3
        О1 Diff — изменения исходного MR
        О2 Юнит-отчёт — исходные результаты тестов
        О3 Покрытие — исходное покрытие
        О4 Задача — требования и критерии приёмки
        О5 Репозиторий — код, тесты, фикстуры,
        сборка и правила проекта"/]
        PREP --> COLLECT --> INPUT
    end

    subgraph S3["3. Разработка сценариев — агентный сервис в Kubernetes"]
        direction TB
        ANALYST["агент: 3.1
        Analyst
        Изучить задачу, diff и отчёты;
        найти нужные файлы и существующие тесты;
        учесть замечания предыдущих итераций"]
        SCENARIOS[/"объекты: 3.2
        О6 Сценарии
        Условия, входные данные,
        ожидаемые результаты, приоритеты;
        связи с требованиями и изменениями"/]
        SIX[/"объекты: 3.3
        О1 Diff
        О2 Юнит-отчёт
        О3 Покрытие
        О4 Задача
        О5 Репозиторий
        О6 Сценарии
        Если уже существуют, также:
        О7 Тесты
        О8 Review-отчёт
        О9 Отзыв автора"/]
        ANALYST --> SCENARIOS --> SIX
    end

    subgraph S4["4. Реализация и запуск — агентный сервис и Runner"]
        direction TB
        PROGRAMMER["агент: 4.1
        Coder — Kubernetes
        Создать или доработать юнит-тесты;
        использовать сценарии и правила проекта;
        не подгонять ожидания под дефект продукта"]
        TESTS[/"объекты: 4.2
        О7 Тесты
        Новые и изменённые юнит-тесты"/]
        SAVE["действие: 4.3
        Сохранить изменения тестов;
        зафиксировать их версию;
        зарегистрировать проверочный job
        и связь с исходным SHA"]
        RUN["действие: 4.4
        GitLab Runner
        Подготовить изолированную рабочую копию;
        применить версию тестов;
        собрать проект, запустить тесты,
        измерить покрытие и сохранить логи"]
        INFRA{"условие: 4.5
        Выполнение прервано
        инфраструктурным сбоем?"}
        RETRYLIMIT{"условие: 4.6
        Остались попытки
        и время для повтора job?"}
        RETRY["действие: 4.7
        Сохранить диагностику;
        зарегистрировать повтор проверочного job"]
        BUILD{"условие: 4.8
        Новые тесты собираются
        и запускаются?"}
        FIXLIMIT{"условие: 4.9
        Остались попытки
        и время для исправления?"}
        ERRORS["действие: 4.10
        Передать Coder
        ошибки сборки и запуска"]
        REPORTS[/"объекты: 4.11
        О2 Юнит-отчёт — новая версия
        О3 Покрытие — новая версия
        Если покрытие не получено:
        сохранить явный статус ошибки"/]
        SEVEN[/"объекты: 4.12
        О1 Diff
        О2 Юнит-отчёт
        О3 Покрытие
        О4 Задача
        О5 Репозиторий
        О6 Сценарии
        О7 Тесты
        Если уже существуют, также:
        О8 Review-отчёт
        О9 Отзыв автора"/]
        STOPP(["завершение: 4.13
        Сохранить результаты и диагностику;
        передать человеку"])
        PROGRAMMER --> TESTS --> SAVE --> RUN --> INFRA
        INFRA -->|"Да"| RETRYLIMIT
        RETRYLIMIT -->|"Да"| RETRY --> RUN
        RETRYLIMIT -->|"Нет"| STOPP
        INFRA -->|"Нет"| BUILD
        BUILD -->|"Нет"| FIXLIMIT
        FIXLIMIT -->|"Да"| ERRORS --> PROGRAMMER
        FIXLIMIT -->|"Нет"| STOPP
        BUILD -->|"Да: тесты могут проходить или падать"| REPORTS
        REPORTS --> SEVEN
    end

    subgraph S5["5. Полная верификация — агентный сервис в Kubernetes"]
        direction TB
        QA["агент: 5.1
        Reviewer
        Проверить требования и сценарии;
        реализацию тестов, assertions и моки;
        условия запуска и причины падений;
        покрытие, использованные файлы
        и замечания автора"]
        QAREPORT[/"объекты: 5.2
        О8 Review-отчёт
        Выводы по каждому объекту;
        изменения относительно предыдущей версии;
        замечания, причины падений
        и обоснование решения"/]
        EIGHT[/"объекты: 5.3
        О1 Diff
        О2 Юнит-отчёт
        О3 Покрытие
        О4 Задача
        О5 Репозиторий
        О6 Сценарии
        О7 Тесты
        О8 Review-отчёт
        О9 Отзыв автора — если получен"/]
        DECISION{"условие: 5.4
        Решение Reviewer"}
        ALIMIT{"условие: 5.5
        Доработка сценариев
        разрешена лимитами процесса?"}
        PLIMIT{"условие: 5.6
        Доработка тестов
        разрешена лимитами процесса?"}
        STOPQ(["завершение: 5.7
        Сохранить Review-отчёт;
        передать человеку"])
        QA --> QAREPORT --> EIGHT --> DECISION
        DECISION -->|"Доработать сценарии"| ALIMIT
        DECISION -->|"Доработать тесты"| PLIMIT
        ALIMIT -->|"Нет"| STOPQ
        PLIMIT -->|"Нет"| STOPQ
    end

    subgraph S6["6. Публикация результата — агентный сервис и GitLab"]
        direction TB
        FRESH{"условие: 6.1
        SHA исходной feature-ветки
        остаётся актуальным?"}
        REFRESHBASE["действие: 6.2
        Зафиксировать новую ревизию;
        получить новый diff и исходные CI-отчёты;
        обновить рабочую копию;
        сохранить историю предыдущей итерации"]
        BASEOK{"условие: 6.3
        Данные новой ревизии
        получены и согласованы?"}
        BASEERR(["завершение: 6.4
        Приостановить обработку;
        сохранить причину;
        передать человеку"])
        UPDATED[/"объекты: 6.5
        О1 Diff — новая ревизия
        О2 Юнит-отчёт — новая ревизия
        О3 Покрытие — новая ревизия
        О4 Задача
        О5 Репозиторий — новая ревизия
        О6 Сценарии — требуют перепроверки
        О7 Тесты — требуют перепроверки
        О8 Review-отчёт — история предыдущей итерации
        О9 Отзыв автора — если получен"/]
        PUBLISH["действие: 6.6
        Опубликовать ветку тестов;
        создать или обновить тот же MR
        ai-tests → feature;
        сохранить идентификатор MR"]
        TESTMR[/"объекты: 6.7
        MR ai-tests → feature
        О7 Тесты
        О8 Review-отчёт
        Ссылки на:
        О2 Юнит-отчёт
        О3 Покрытие"/]
        WAIT(["состояние: 6.8
        Ожидание автора
        и обязательных проверок GitLab"])
        FRESH -->|"Нет"| REFRESHBASE --> BASEOK
        BASEOK -->|"Нет"| BASEERR
        BASEOK -->|"Да"| UPDATED
        FRESH -->|"Да"| PUBLISH --> TESTMR --> WAIT
    end

    subgraph S7["7. Принятие и обратная связь — GitLab"]
        direction TB
        EVENT{"условие: 7.1
        Какое событие получено?"}
        MERGEOK{"условие: 7.2
        Слияние разрешено
        проверками и правилами проекта?"}
        MERGE["действие: 7.3
        Человек сливает MR с тестами;
        Runner повторяет CI исходного MR"]
        END(["завершение: 7.4
        Итерация завершена
        Повторная оценка QG —
        с защитой от дубликатов и зацикливания"])
        VALIDAUTHOR{"условие: 7.5
        Новый 👎 поставлен
        автором исходного MR?"}
        FEEDBACK[/"объекты: 7.6
        О9 Отзыв автора
        Реакция 👎;
        комментарий с меткой — если есть"/]
        REFRESH["действие: 7.7
        Зарегистрировать событие один раз;
        проверить текущие ревизии;
        обновить изменившиеся данные и отчёты;
        сохранить замечания"]
        ACTIVE{"условие: 7.8
        Доработка этого MR уже выполняется?"}
        ATTACH["действие: 7.9
        Передать новые замечания
        в активную доработку;
        не создавать параллельный запуск"]
        NINE[/"объекты: 7.10
        О1 Diff
        О2 Юнит-отчёт
        О3 Покрытие
        О4 Задача
        О5 Репозиторий
        О6 Сценарии
        О7 Тесты
        О8 Review-отчёт
        О9 Отзыв автора"/]
        LATE["действие: 7.11
        Сохранить поздний комментарий с меткой;
        включить в активную доработку
        или следующий повторный запуск"]
        EVENT -->|"Автор хочет принять"| MERGEOK
        MERGEOK -->|"Да"| MERGE --> END
        MERGEOK -->|"Нет"| WAIT
        EVENT -->|"Реакция 👎"| VALIDAUTHOR
        VALIDAUTHOR -->|"Нет: не запускать"| WAIT
        VALIDAUTHOR -->|"Да"| FEEDBACK --> REFRESH --> ACTIVE
        ACTIVE -->|"Да"| ATTACH
        ACTIVE -->|"Нет"| NINE
        EVENT -->|"Поздний комментарий автора с меткой"| LATE
        LATE --> WAIT
    end

    START --> CI
    UNIQUE -->|"Нет"| PREP
    INPUT --> ANALYST
    SIX --> PROGRAMMER
    SEVEN --> QA
    ALIMIT -->|"Да: все объекты 5.3 и замечания"| ANALYST
    PLIMIT -->|"Да: все объекты 5.3 и замечания"| PROGRAMMER
    DECISION -->|"Создать или обновить MR"| POLICY
    POLICY{"условие: 5.8
    Кодом подтверждены допустимые изменения,
    успешный запуск и целевой QG
    на проверяемой ревизии?"}
    POLICY -->|"Да"| FRESH
    POLICY -->|"Нет: дефект продукта или блокировка"| STOPQ
    UPDATED --> NEWTRIGGER
    NEWTRIGGER{"условие: 6.5.1
    Это доработка по отзыву автора?"}
    NEWQG{"условие: 6.5.2
    Новая ревизия по-прежнему
    разрешена и не прошла coverage QG?"}
    NEWTRIGGER -->|"Да"| ANALYST
    NEWTRIGGER -->|"Нет"| NEWQG
    NEWQG -->|"Да"| ANALYST
    NEWQG -->|"Нет"| PASS
    WAIT -->|"Получено событие"| EVENT
    NINE -->|"Повторное ревью;
    провал QG не требуется"| QA

    subgraph S8["8. Общая инфраструктура — обслуживает все этапы"]
        direction TB
        APP["сервис: 8.1
        Kubernetes — Deployment 1
        Python + FastAPI + LangGraph
        Analyst, Coder и Reviewer;
        MCP-клиент и инструменты;
        приём событий, переходы и лимиты"]
        RULES["инструкции: 8.2
        Централизованно в агентной системе:
        общие правила, роли, стеки и ограничения
        В репозитории продукта:
        команды, пути и особенности тестирования"]
        PROXY["сервис: 8.3
        Kubernetes — Deployment 2
        LiteLLM Proxy
        Единый API моделей;
        маршрутизация, балансировка и повторы"]
        subgraph SPARKS["8.4. Независимые серверы моделей"]
            direction LR
            SP1["сервер: 8.4.1
            DGX Spark 1 — 128 ГБ
            SGLang + модель
            предложенный runtime"]
            SP2["сервер: 8.4.2
            DGX Spark 2 — 128 ГБ
            SGLang + модель
            предложенный runtime"]
            SP3["сервер: 8.4.3
            DGX Spark 3 — 128 ГБ
            SGLang + модель
            предложенный runtime"]
        end
        SYSTEMS["серверы: 8.5
        GitLab и YouTrack
        MCP для доступных операций;
        API для недостающих;
        Git для получения и публикации кода"]
        RUNNERS["исполнители: 8.6
        Существующие GitLab Runner
        Изолированные рабочие копии;
        поиск, чтение и изменение файлов
        через управляемые задания;
        сборка, тесты и покрытие"]
        DB[("хранилище: 8.7
        PostgreSQL вне Kubernetes
        Состояние процесса и контрольные точки;
        SHA, версии и ссылки;
        идентификаторы job и MR;
        итерации и обработанные события")]
        ART[("хранилище: 8.8
        GitLab и постоянные артефакты
        О1 Diff
        О2 Юнит-отчёт
        О3 Покрытие
        О4 Задача — снимок
        О5 Репозиторий — Git-ревизия
        О6 Сценарии
        О7 Тесты
        О8 Review-отчёт
        О9 Отзыв автора
        Сохранение по мере появления;
        история предыдущих версий")]
        RESTART(["событие: 8.9
        Перезапуск агентного приложения"])
        LOAD["действие: 8.10
        Найти незавершённые процессы;
        загрузить контрольные точки"]
        JOB{"условие: 8.11
        Есть зарегистрированный
        незавершённый проверочный job?"}
        JOBSTATUS{"условие: 8.12
        Текущее состояние job"}
        WAITJOB["действие: 8.13
        Продолжить ожидание существующего job"]
        FETCH["действие: 8.14
        Получить результаты существующего job;
        сохранить ссылки на артефакты"]
        RESUME["действие: 8.15
        Продолжить с сохранённого этапа;
        незавершённый вызов модели повторить;
        перед внешним действием проверить,
        не выполнено ли оно ранее"]
        RULES -.-> APP
        APP -.->|"Запросы и ответы моделей"| PROXY
        PROXY -.-> SP1
        PROXY -.-> SP2
        PROXY -.-> SP3
        APP -.->|"MCP / API / Git"| SYSTEMS
        APP -.->|"Задания через GitLab"| RUNNERS
        APP -.->|"Состояние и контрольные точки"| DB
        APP -.->|"Объекты и история"| ART
        RUNNERS -.->|"Сохранить до удаления рабочей копии"| ART
        RESTART --> LOAD --> JOB
        DB -.-> LOAD
        JOB -->|"Нет"| RESUME
        JOB -->|"Да"| JOBSTATUS
        JOBSTATUS -->|"В очереди или выполняется"| WAITJOB
        JOBSTATUS -->|"Завершён"| FETCH --> RESUME
        JOBSTATUS -->|"Потерян или прерван"| RESUME
        WAITJOB -->|"После завершения"| FETCH
        RESUME -.->|"Возобновление процесса"| APP
    end

    APP -.->|"Общий исполнитель всех агентных этапов"| QA

    classDef action fill:#F1F5F9,stroke:#64748B,color:#0F172A
    classDef agent fill:#DCFCE7,stroke:#16A34A,color:#14532D,stroke-width:2px
    classDef object fill:#DBEAFE,stroke:#2563EB,color:#172554,stroke-width:2px
    classDef condition fill:#FEF3C7,stroke:#D97706,color:#78350F,stroke-width:2px
    classDef infrastructure fill:#EDE9FE,stroke:#7C3AED,color:#4C1D95,stroke-width:2px
    classDef terminal fill:#FFE4E6,stroke:#E11D48,color:#881337

    class LA,LP1,LP2,LQ2,LQ3,CI,PREP,COLLECT,SAVE,RUN,RETRY,ERRORS,REFRESHBASE,PUBLISH,MERGE,REFRESH,ATTACH,LATE,LOAD,WAITJOB,FETCH,RESUME action
    class LG,LF2,ANALYST,PROGRAMMER,QA agent
    class LO,LF1,INPUT,SCENARIOS,SIX,TESTS,REPORTS,SEVEN,QAREPORT,EIGHT,UPDATED,TESTMR,FEEDBACK,NINE object
    class LC,LQ1,VALID,QG,ELIGIBLE,UNIQUE,INFRA,RETRYLIMIT,BUILD,FIXLIMIT,DECISION,ALIMIT,PLIMIT,FRESH,BASEOK,EVENT,MERGEOK,VALIDAUTHOR,ACTIVE,JOB,JOBSTATUS condition
    class LS,LD,LI1,LI2,APP,RULES,PROXY,SP1,SP2,SP3,SYSTEMS,RUNNERS,DB,ART infrastructure
    class LB,LE,START,CIERR,PASS,IGNORE,EXISTING,STOPP,STOPQ,BASEERR,WAIT,END,RESTART terminal


    class NEWTRIGGER,NEWQG,POLICY condition
